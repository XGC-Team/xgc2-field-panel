#!/usr/bin/env python
# -*- coding: utf-8 -*-
# Sim-only: /odom -> PlanarStateEstimate. Not a substitute for the real estimator.
# Odometry twist is in the child (body) frame. Downstream NMPC treats
# PlanarStateEstimate.velocity as world-frame, so convert here.
from __future__ import print_function

import math
import os
import sys

import rospy
from nav_msgs.msg import Odometry
from rigid_state_estimator_msgs.msg import PlanarStateEstimate


def _yaw_from_quat(q):
    siny_cosp = 2.0 * (q.w * q.z + q.x * q.y)
    cosy_cosp = 1.0 - 2.0 * (q.y * q.y + q.z * q.z)
    return math.atan2(siny_cosp, cosy_cosp)


class Bridge(object):
    def __init__(self):
        ns = rospy.get_param("~ns", os.environ.get("FIELD_PANEL_NS", "ugv1"))
        odom = rospy.get_param("~odom_topic", "/%s/odom" % ns)
        state = rospy.get_param("~state_topic", "/%s/alg/state_estimator/state" % ns)
        self.pub = rospy.Publisher(state, PlanarStateEstimate, queue_size=20)
        rospy.Subscriber(odom, Odometry, self._on_odom, queue_size=20)
        rospy.loginfo("odom_to_planar_state %s -> %s", odom, state)

    def _on_odom(self, msg):
        yaw = _yaw_from_quat(msg.pose.pose.orientation)
        cy = math.cos(yaw)
        sy = math.sin(yaw)
        bx = msg.twist.twist.linear.x
        by = msg.twist.twist.linear.y
        out = PlanarStateEstimate()
        out.header = msg.header
        out.estimator_state = PlanarStateEstimate.STATE_RUNNING
        out.flags = 0
        out.position = msg.pose.pose.position
        out.orientation = msg.pose.pose.orientation
        out.velocity.x = bx * cy - by * sy
        out.velocity.y = bx * sy + by * cy
        out.velocity.z = msg.twist.twist.linear.z
        out.angular_velocity = msg.twist.twist.angular
        out.vrpn_observation_state = PlanarStateEstimate.VRPN_HEALTH_TRUSTED
        out.filter_health = PlanarStateEstimate.FILTER_HEALTH_NOMINAL
        out.last_pose_accepted = True
        out.last_fused_pose_stamp_sec = msg.header.stamp.to_sec()
        self.pub.publish(out)


def main():
    rospy.init_node("odom_to_planar_state")
    Bridge()
    rospy.spin()


if __name__ == "__main__":
    try:
        main()
    except rospy.ROSInterruptException:
        sys.exit(0)
